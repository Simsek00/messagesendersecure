# Bu dosyayı ".env" adıyla kopyalayıp değerleri kendinize göre doldurun.
# .env dosyası .gitignore'dadır, asla commit'lemeyin.

# Flask oturum (session) imzalama anahtarı
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-rastgele-uzun-bir-deger-yazin

# Mesaj şifreleme için Fernet (AES) anahtarı
# Üretmek için: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=buraya-fernet-anahtarini-yapistirin
